# Project-local runtime configuration for deploy/paper-codex.user.service
PAPER_CODEX_BIND=127.0.0.1:3000
PAPER_CODEX_WORKSPACE=./paper-workspace
PAPER_CODEX_STATIC_DIR=./.runtime/current/web
PAPER_CODEX_CODEX_BIN=codex
# PAPER_CODEX_CODEX_HOME=./.codex
PAPER_CODEX_RUNTIME_TMP=./.runtime/tmp
PAPER_CODEX_PASSWORD_HASH=replace-with-bcrypt-hash
PAPER_CODEX_JWT_SECRET=replace-with-at-least-32-random-bytes
PAPER_CODEX_MAX_UPLOAD_BYTES=104857600
PAPER_CODEX_RESEARCH_CACHE_DIR=./.runtime/research-cache
PAPER_CODEX_RESEARCH_CACHE_MAX_BYTES=1073741824
PAPER_CODEX_RESEARCH_PDF_MAX_BYTES=104857600
PAPER_CODEX_RESEARCH_MAX_CONCURRENCY=3
PAPER_CODEX_RESEARCH_CACHE_TTL_DAYS=30
RUST_LOG=paper_codex=info,tower_http=info
